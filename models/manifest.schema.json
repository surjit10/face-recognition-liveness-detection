{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faceguard.local/schemas/model-manifest-v1.json",
  "title": "FaceGuard candidate release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "state",
    "detector_recognizer",
    "pad",
    "recognition",
    "environment_lock_sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "release_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["candidate", "released"]},
    "created_at": {"type": "string", "format": "date-time"},
    "environment_lock_sha256": {"$ref": "#/$defs/sha256"},
    "detector_recognizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "pack_source", "detector_file", "detector_sha256", "recognizer_file", "recognizer_sha256", "embedding_dim"],
      "properties": {
        "pack": {"const": "buffalo_m"},
        "pack_source": {"type": "string", "minLength": 1},
        "detector_file": {"$ref": "#/$defs/relativePath"},
        "detector_sha256": {"$ref": "#/$defs/sha256"},
        "recognizer_file": {"$ref": "#/$defs/relativePath"},
        "recognizer_sha256": {"$ref": "#/$defs/sha256"},
        "embedding_dim": {"const": 512}
      }
    },
    "pad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "input_name", "input_shape", "output_name", "threshold", "threshold_report_sha256"],
      "properties": {
        "file": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "input_name": {"type": "string", "minLength": 1},
        "input_shape": {"const": [1, 3, 224, 224]},
        "output_name": {"type": "string", "minLength": 1},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "threshold_report_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gallery_file", "gallery_sha256", "gallery_manifest_sha256", "embedding_model_sha256", "threshold", "min_top1_top2_margin", "threshold_report_sha256"],
      "properties": {
        "gallery_file": {"$ref": "#/$defs/relativePath"},
        "gallery_sha256": {"$ref": "#/$defs/sha256"},
        "gallery_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "embedding_model_sha256": {"$ref": "#/$defs/sha256"},
        "threshold": {"type": "number", "minimum": -1, "maximum": 1},
        "min_top1_top2_margin": {"type": "number", "minimum": 0, "maximum": 2},
        "threshold_report_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
  }
}
